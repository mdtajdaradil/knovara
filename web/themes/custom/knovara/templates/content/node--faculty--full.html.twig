{#
/**
* @file
* Full Faculty profile display.
*/
#}

{{ attach_library('knovara/faculty') }}

{% set faculty_name = node.getTitle()|trim %}
{% set first_name_source = faculty_name|replace({
'Dr. ': '',
'Prof. ': '',
'Mr. ': '',
'Mrs. ': '',
'Ms. ': ''
}) %}
{% set first_name = first_name_source|trim|split(' ')|first %}

{% set role = node.field_faculty_role.value %}
{% set lead = node.field_faculty_lead.value %}
{% set profile_heading = node.field_faculty_profile_heading.value %}

{% set years = not node.field_years_of_experience.isEmpty()
? node.field_years_of_experience.value
: null
%}

{% set rating = not node.field_faculty_rating.isEmpty()
? node.field_faculty_rating.value
: null
%}

{% set courses_taught = not node.field_faculty_courses_taught.isEmpty()
? node.field_faculty_courses_taught.value
: null
%}

{% set classes = [
'faculty-profile-node',
'node',
'node--type-faculty',
not node.isPublished() ? 'node--unpublished'
] %}

<article{{ attributes.addClass(classes) }}>

    <section class="page-hero page-hero--dark">
        <div class="shell">

            <nav class="breadcrumb" aria-label="{{ 'Breadcrumb'|t }}">
                <a href="{{ url('<front>') }}">{{ 'Home'|t }}</a>
                <span aria-hidden="true">/</span>
                <a href="/faculty">{{ 'Faculty'|t }}</a>
                <span aria-hidden="true">/</span>
                <span aria-current="page">{{ faculty_name }}</span>
            </nav>

            {{ title_prefix }}

            {% if role %}
            <span class="eyebrow">{{ role }}</span>
            {% endif %}

            <h1{{ title_attributes }}>{{ faculty_name }}</h1>

                {{ title_suffix }}

                {% if lead %}
                <p class="lead">{{ lead }}</p>
                {% endif %}

                {% if years or rating or courses_taught %}
                <div class="meta-row" aria-label="{{ 'Faculty highlights'|t }}">

                    {% if years %}
                    <span>{{ years }} {{ 'years of experience'|t }}</span>
                    {% endif %}

                    {% if rating %}
                    <span>{{ rating }} {{ 'learner rating'|t }}</span>
                    {% endif %}

                    {% if courses_taught %}
                    <span>{{ courses_taught }} {{ 'courses taught'|t }}</span>
                    {% endif %}

                </div>
                {% endif %}

        </div>
    </section>

    <section class="section">
        <div class="shell detail-grid">

            <div class="prose">

                <span class="eyebrow">
                    {{ 'About @name'|t({'@name': first_name}) }}
                </span>

                {% if profile_heading %}
                <h2>{{ profile_heading }}</h2>
                {% endif %}

                {% if not node.body.isEmpty() %}
                {{ content.body }}
                {% endif %}

                {% if not node.field_faculty_quote.isEmpty() %}
                <p class="quote">
                    “{{ node.field_faculty_quote.value }}”
                </p>
                {% endif %}

                {% if not node.field_faculty_qualifications.isEmpty() %}
                <h3>{{ 'Qualifications'|t }}</h3>
                {{ content.field_faculty_qualifications }}
                {% endif %}

                {% if not node.field_faculty_expertise.isEmpty() %}
                <h3>{{ 'Areas of expertise'|t }}</h3>

                <div class="cluster" aria-label="{{ 'Areas of expertise'|t }}">
                    {% for expertise in node.field_faculty_expertise %}
                    {% if expertise.entity %}
                    <span class="badge">
                        {{ expertise.entity.label() }}
                    </span>
                    {% endif %}
                    {% endfor %}
                </div>
                {% endif %}

                {% if not node.field_faculty_teaching_approach.isEmpty() %}
                <h3>{{ 'Teaching approach'|t }}</h3>
                {{ content.field_faculty_teaching_approach }}
                {% endif %}

                {% if not node.field_faculty_teaching_image.isEmpty() %}
                {% set teaching_image = node.field_faculty_teaching_image.0 %}

                <figure class="faculty-story-image">
                    <img src="{{ file_url(teaching_image.entity.uri.value) }}" alt="{{ teaching_image.alt }}" {% if
                        teaching_image.width %} width="{{ teaching_image.width }}" {% endif %} {% if
                        teaching_image.height %} height="{{ teaching_image.height }}" {% endif %} loading="lazy"
                        decoding="async">
                </figure>
                {% endif %}

                {#
                The Upcoming Teaching View will be supplied later through
                knovara_preprocess_node().
                #}
                {% if upcoming_teaching is defined and upcoming_teaching %}
                <h3>{{ 'Upcoming teaching'|t }}</h3>

                <div class="timeline">
                    {{ upcoming_teaching }}
                </div>
                {% endif %}

            </div>

            <aside class="detail-rail faculty-contact-card">

                {% if not node.field_faculty_photo.isEmpty() %}
                {% set profile_photo = node.field_faculty_photo.0 %}

                <div class="faculty-profile-avatar">
                    <img class="faculty-profile-image" src="{{ file_url(profile_photo.entity.uri.value) }}"
                        alt="{{ profile_photo.alt ?: ('Portrait of @name'|t({'@name': faculty_name})) }}" {% if
                        profile_photo.width %} width="{{ profile_photo.width }}" {% endif %} {% if profile_photo.height
                        %} height="{{ profile_photo.height }}" {% endif %} loading="lazy" decoding="async">
                </div>
                {% endif %}

                <h3>
                    {{ 'Ask @name a question'|t({'@name': first_name}) }}
                </h3>

                <p class="muted">
                    {{ 'Enrolled learners can use weekly faculty office hours. New learners can speak to an advisor
                    first.'|t }}
                </p>

                <a class="button button--teal button--block" href="/contact">
                    {{ 'Contact an advisor'|t }}
                </a>

                <div class="divider"></div>

                <a class="text-link" href="/courses">
                    {{ 'View @name’s courses'|t({'@name': first_name}) }}
                </a>

                {% if
                not node.field_faculty_email.isEmpty()
                or not node.field_faculty_linkedin.isEmpty()
                or not node.field_faculty_website.isEmpty()
                %}
                <div class="faculty-contact-links">
                    {{ content.field_faculty_email }}
                    {{ content.field_faculty_linkedin }}
                    {{ content.field_faculty_website }}
                </div>
                {% endif %}

            </aside>

        </div>
    </section>

    </article>